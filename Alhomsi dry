        // Render Item Buttons
        function renderItems() {
            const grid = document.getElementById('itemGrid');
            grid.innerHTML = clothes.map(c => `
                <button onclick="selectCloth('${c.id}')" id="btn-item-${c.id}" class="item-btn flex flex-col items-center justify-center p-3 border ${c.id === 'custom' ? 'border-amber-300 bg-amber-50/50 hover:bg-amber-100/60' : 'border-slate-200 bg-white hover:bg-blue-50'} rounded-xl hover:border-blue-400 active:scale-95 transition text-slate-700 shadow-sm">
                    <i class="fa-solid ${c.icon} text-2xl ${c.id === 'custom' ? 'text-amber-600' : 'text-blue-600'} mb-1.5"></i>
                    <span class="text-xs font-bold text-center leading-tight">${currentLang === 'ar' ? c.name_ar : c.name_tr}</span>
                </button>
            `).join('');
        }

        // Handle Item Click
        function selectCloth(id) {
            selectedItem = clothes.find(c => c.id === id);
            
            // Highlight selected button
            document.querySelectorAll('.item-btn').forEach(btn => btn.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50'));
            const activeBtn = document.getElementById(`btn-item-${id}`);
            if (activeBtn) activeBtn.classList.add('ring-2', 'ring-blue-500', 'bg-blue-50');

            document.getElementById('serviceControls').classList.remove('hidden');

            const customNameContainer = document.getElementById('customNameContainer');
            if (id === 'custom') {
                document.getElementById('selectedItemTitle').innerText = currentLang === 'ar' ? 'إضافة قطعة مخصصة' : 'Özel Ürün Ekleme';
                if (!customNameContainer) {
                    const nameInputHtml = `
                        <div id="customNameContainer" class="bg-amber-50 p-2.5 rounded-xl border border-amber-200 mb-2">
                            <label class="block text-[11px] font-bold text-amber-900 mb-1">اسم القطعة (كتابة خاصة):</label>
                            <input type="text" id="customItemName" placeholder="مثال: ستارة، سجاد، قبعة..." class="w-full bg-white border border-amber-300 rounded-lg p-2 text-xs font-bold focus:ring-2 focus:ring-amber-500 outline-none">
                        </div>
                    `;
                    document.getElementById('serviceControls').insertAdjacentHTML('afterbegin', nameInputHtml);
                } else {
                    customNameContainer.classList.remove('hidden');
                }
            } else {
                document.getElementById('selectedItemTitle').innerText = currentLang === 'ar' ? selectedItem.name_ar : selectedItem.name_tr;
                if (customNameContainer) {
                    customNameContainer.classList.add('hidden');
                }
            }
            
            // Reset checkboxes
            document.getElementById('srvWashing').checked = true;
            document.getElementById('srvIroning').checked = true;
            document.getElementById('srvDryClean').checked = false;
            document.getElementById('srvTailoring').checked = false;
            document.getElementById('itemQty').value = 1;
            document.getElementById('itemNotes').value = '';

            calculateSuggestedPrice();
        }

        // Adjust Quantity
        function changeQty(delta) {
            const qtyInput = document.getElementById('itemQty');
            let current = parseInt(qtyInput.value) || 1;
            current += delta;
            if (current < 1) current = 1;
            qtyInput.value = current;
            calculateSuggestedPrice();
        }

        // Auto calculate price based on item base price, services selected, and quantity
        function calculateSuggestedPrice() {
            if (!selectedItem) return;
            
            let multiplier = 0;
            if (document.getElementById('srvWashing').checked) multiplier += 0.6;
            if (document.getElementById('srvIroning').checked) multiplier += 0.4;
            if (document.getElementById('srvDryClean').checked) multiplier += 1.0;
            if (document.getElementById('srvTailoring').checked) multiplier += 0.8;

            if (multiplier === 0) multiplier = 0.5; // default fallback

            const qty = parseInt(document.getElementById('itemQty').value) || 1;
            const calculated = Math.round(selectedItem.basePrice * multiplier * qty);
            document.getElementById('itemPrice').value = calculated;
        }

        // Add Item to Cart
        function addItemToCart() {
            if (!selectedItem) return;

            let itemName = currentLang === 'ar' ? selectedItem.name_ar : selectedItem.name_tr;

            if (selectedItem.id === 'custom') {
                const customInput = document.getElementById('customItemName');
                const customVal = customInput ? customInput.value.trim() : '';
                if (!customVal) {
                    showToast(translations[currentLang].msg_enter_item_name, 'warning');
                    return;
                }
                itemName = customVal;
            }

            const qty = parseInt(document.getElementById('itemQty').value) || 1;
            const price = parseFloat(document.getElementById('itemPrice').value) || 0;
            const notes = document.getElementById('itemNotes').value.trim();

            const services = [];
            if (document.getElementById('srvWashing').checked) services.push(translations[currentLang].srv_wash);
            if (document.getElementById('srvIroning').checked) services.push(translations[currentLang].srv_iron);
            if (document.getElementById('srvDryClean').checked) services.push(translations[currentLang].srv_dryclean);
            if (document.getElementById('srvTailoring').checked) services.push(translations[currentLang].srv_tailor);

            if (services.length === 0) {
                showToast(translations[currentLang].msg_select_service, 'warning');
                return;
            }

            cart.push({
                id: Date.now(),
                name: itemName,
                qty,
                price,
                notes,
                services: services.join(' + ')
            });

            updateCart();
            showToast(translations[currentLang].msg_item_added, 'success');

            // Reset Controls
            document.getElementById('serviceControls').classList.add('hidden');
            document.querySelectorAll('.item-btn').forEach(btn => btn.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50'));
            selectedItem = null;
        }

        // Update Cart UI
        function updateCart() {
            const list = document.getElementById('cartList');
            const totalEl = document.getElementById('totalPrice');
            document.getElementById('cartCount').innerText = cart.length;

            if (cart.length === 0) {
                list.innerHTML = `
                    <div class="text-center text-slate-400 py-10 flex flex-col items-center gap-2">
                        <i class="fa-solid fa-basket-shopping text-4xl text-slate-200"></i>
                        <p class="text-xs">${translations[currentLang].cart_empty}</p>
                    </div>`;
                totalEl.innerText = '0.00 TL';
                return;
            }

            let total = 0;
            list.innerHTML = cart.map((item, idx) => {
                total += item.price;
                return `
                    <div class="flex justify-between items-center pt-2 pb-2">
                        <div class="space-y-0.5">
                            <p class="font-extrabold text-slate-800 text-xs">${item.name} <span class="text-blue-600">(x${item.qty})</span></p>
                            <p class="text-[10px] text-slate-500 font-semibold">${item.services}</p>
                            ${item.notes ? `<p class="text-[9px] text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded inline-block">📝 ${item.notes}</p>` : ''}
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-black text-xs text-blue-900">${item.price.toFixed(2)} TL</span>
                            <button onclick="removeFromCart(${idx})" class="text-slate-400 hover:text-red-500 transition p-1">
                                <i class="fa-solid fa-trash text-xs"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            totalEl.innerText = total.toFixed(2) + ' TL';
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCart();
        }

        // Confirm & Print Order
        function confirmAndSend() {
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();

            if (!name || cart.length === 0) {
                showToast(translations[currentLang].msg_empty_fields, 'warning');
                return;
            }

            const total = cart.reduce((sum, item) => sum + item.price, 0);
            const orderNo = '#' + Math.floor(100000 + Math.random() * 900000);
            const dateStr = new Date().toLocaleString(currentLang === 'ar' ? 'ar-EG' : 'tr-TR');

            // Save to localStorage
            const newOrder = {
                id: orderNo,
                date: dateStr,
                customer: name,
                phone: phone || '-',
                items: [...cart],
                total: total
            };
            orderHistory.unshift(newOrder);
            localStorage.setItem('alhomsi_laundry_orders', JSON.stringify(orderHistory));

            // Fill Print Receipt
            document.getElementById('rcptCustomer').innerText = name;
            document.getElementById('rcptPhone').innerText = phone || '-';
            document.getElementById('rcptDate').innerText = dateStr;
            document.getElementById('rcptOrderNo').innerText = 'رقم الطلب: ' + orderNo;
            
            document.getElementById('rcptItems').innerHTML = cart.map(i => `
                <tr>
                    <td class="py-1 font-bold">${i.name}</td>
                    <td class="py-1 text-slate-600">${i.services}</td>
                    <td class="py-1 text-center font-bold">${i.qty}</td>
                    <td class="py-1 text-left font-bold">${i.price.toFixed(2)} TL</td>
                </tr>
            `).join('');
            document.getElementById('rcptTotal').innerText = total.toFixed(2);

            // Trigger Window Print
            window.print();

            // Clear Current Form
            cart = [];
            updateCart();
            document.getElementById('customerName').value = '';
            document.getElementById('customerPhone').value = '';
        }

        // Send Order Receipt via WhatsApp
        function sendViaWhatsApp() {
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();

            if (!name || cart.length === 0) {
                showToast(translations[currentLang].msg_empty_fields, 'warning');
                return;
            }

            let cleanPhone = phone.replace(/[^0-9]/g, '');
            if (!cleanPhone) {
                showToast('يرجى إدخال رقم هاتف صحيح لإرسال الفاتورة عبر الواتساب', 'warning');
                return;
            }

            let total = cart.reduce((sum, item) => sum + item.price, 0);
            let msg = `*مغسلة ملابس ALHOMSI LAUNDRY*\n`;
            msg += `أهلاً بك عزيزي: *${name}*\n`;
            msg += `تفاصيل طلبك لدينا:\n--------------------------\n`;
            
            cart.forEach(item => {
                msg += `• ${item.name} (${item.qty} قطعة) - [${item.services}] : ${item.price} TL\n`;
            });
            
            msg += `--------------------------\n`;
            msg += `*المجموع الكلي: ${total.toFixed(2)} TL*\n\n`;
            msg += `شكراً لزيارتكم! 🧼✨`;

            const encodedMsg = encodeURIComponent(msg);
            window.open(`https://wa.me/${cleanPhone}?text=${encodedMsg}`, '_blank');
        }

        // Modal History Controls
        function openHistoryModal() {
            renderHistoryOrders();
            document.getElementById('historyModal').classList.remove('hidden');
        }

        function closeHistoryModal() {
            document.getElementById('historyModal').classList.add('hidden');
        }

        function renderHistoryOrders() {
            const container = document.getElementById('historyOrdersList');
            if (orderHistory.length === 0) {
                container.innerHTML = `
                    <div class="text-center text-slate-400 py-10">
                        <i class="fa-solid fa-folder-open text-4xl mb-2"></i>
                        <p class="text-xs">لا يوجد أي فواتير مسجلة سابقاً</p>
                    </div>`;
                return;
            }

            container.innerHTML = orderHistory.map(o => `
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 mb-3 hover:border-blue-300 transition shadow-sm">
                    <div class="flex justify-between items-center border-b border-slate-200 pb-2 mb-2 text-xs">
                        <div>
                            <span class="font-extrabold text-blue-900">${o.customer}</span>
                            <span class="text-slate-400 text-[10px] ml-2">(${o.phone})</span>
                        </div>
                        <div class="text-slate-500 text-[10px]">
                            <span>${o.id}</span> | <span>${o.date}</span>
                        </div>
                    </div>
                    <div class="text-xs space-y-1 mb-2">
                        ${o.items.map(i => `<div class="flex justify-between text-slate-600"><span>• ${i.name} (x${i.qty}) - ${i.services}</span><span>${i.price} TL</span></div>`).join('')}
                    </div>
                    <div class="flex justify-between items-center border-t border-slate-200 pt-2 text-xs font-bold">
                        <span class="text-blue-900">المجموع: ${o.total.toFixed(2)} TL</span>
                        <button onclick="reprintHistoryOrder('${o.id}')" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-[11px] flex items-center gap-1 transition">
                            <i class="fa-solid fa-print"></i> إعادة طباعة
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function reprintHistoryOrder(orderId) {
            const order = orderHistory.find(o => o.id === orderId);
            if (!order) return;

            document.getElementById('rcptCustomer').innerText = order.customer;
            document.getElementById('rcptPhone').innerText = order.phone;
            document.getElementById('rcptDate').innerText = order.date;
            document.getElementById('rcptOrderNo').innerText = 'رقم الطلب: ' + order.id;
            
            document.getElementById('rcptItems').innerHTML = order.items.map(i => `
                <tr>
                    <td class="py-1 font-bold">${i.name}</td>
                    <td class="py-1 text-slate-600">${i.services}</td>
                    <td class="py-1 text-center font-bold">${i.qty}</td>
                    <td class="py-1 text-left font-bold">${i.price.toFixed(2)} TL</td>
                </tr>
            `).join('');
            document.getElementById('rcptTotal').innerText = order.total.toFixed(2);

            window.print();
        }

        function clearAllHistory() {
            if (confirm('هل أنت تأكد من مسح كافة سجل الفواتير والمبيعات؟')) {
                orderHistory = [];
                localStorage.removeItem('alhomsi_laundry_orders');
                renderHistoryOrders();
            }
        }

        // Language Switcher
        function toggleLanguage() {
            currentLang = currentLang === 'ar' ? 'tr' : 'ar';
            document.documentElement.dir = currentLang === 'ar' ? 'rtl' : 'ltr';
            document.getElementById('langBtn').innerHTML = currentLang === 'ar' ? '<i class="fa-solid fa-globe text-cyan-400"></i> <span>Türkçe</span>' : '<i class="fa-solid fa-globe text-cyan-400"></i> <span>العربية</span>';
            
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (translations[currentLang][key]) {
                    el.innerText = translations[currentLang][key];
                }
            });

            renderItems();
            updateCart();
        }

        // Helper Toast Notification
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.innerText = message;
            if (type === 'warning') {
                toastIcon.className = 'fa-solid fa-triangle-exclamation text-amber-400 text-lg';
            } else {
                toastIcon.className = 'fa-solid fa-circle-check text-emerald-400 text-lg';
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Initialize App on load
        window.onload = function() {
            renderItems();
            updateCart();
        };
    </script>
</body>
</html>
