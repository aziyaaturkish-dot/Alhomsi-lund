        ];

        let currentLang = 'ar';
        let selectedItem = null;
        let cart = [];
        let orderHistory = JSON.parse(localStorage.getItem('alhomsi_laundry_orders') || '[]');

        // Dictionary for multi-language support
        const translations = {
            ar: {
                header_subtitle: 'نظام إدارة مغسلة الملابس الحديث',
