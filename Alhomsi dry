
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALHOMSI - نظام إدارة المغسلة المحترف</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Cairo', sans-serif;
        }
        
        /* Print Styles - optimized for 80mm receipt & A4 */
        @media print {
            body * { visibility: hidden; }
            #printable-receipt, #printable-receipt * { visibility: visible; }
            #printable-receipt { 
                position: absolute; 
                left: 0; 
                top: 0; 
                width: 100%; 
                max-width: 80mm;
                padding: 10px;
                margin: 0 auto;
                font-size: 11px;
                color: #000;
            }
            .no-print { display: none !important; }
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- Toast Notification Box -->
    <div id="toast" class="fixed bottom-5 left-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl transition-all duration-300 transform translate-y-20 opacity-0 flex items-center gap-3 border border-slate-700">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
        <span id="toastMsg" class="text-xs font-semibold"></span>
    </div>

    <!-- Main Header -->
    <header class="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 text-white shadow-lg sticky top-0 z-40 border-b border-blue-700">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="bg-white/10 p-2.5 rounded-xl backdrop-blur-sm border border-white/20">
                    <i class="fa-solid fa-soap text-2xl text-cyan-300 animate-pulse"></i>
                </div>
                <div>
                    <h1 class="text-lg font-black tracking-wider flex items-center gap-2">
                        ALHOMSI <span class="bg-cyan-500 text-blue-950 text-[10px] uppercase px-2 py-0.5 rounded-full font-extrabold tracking-normal">Laundry POS</span>
                    </h1>
                    <p class="text-[11px] text-blue-200" data-key="header_subtitle">نظام إدارة مغسلة الملابس الحديث</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <!-- Orders History Modal Button -->
                <button onclick="openHistoryModal()" class="bg-white/10 hover:bg-white/20 text-white text-xs px-3 py-2 rounded-lg border border-white/20 transition flex items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left text-cyan-300"></i>
                    <span class="hidden sm:inline" data-key="btn_history">سجل الطلبات</span>
                </button>

                <!-- Language Switcher -->
                <button onclick="toggleLanguage()" class="bg-blue-950 hover:bg-blue-900 text-white text-xs px-3 py-2 rounded-lg border border-blue-700 transition flex items-center gap-1.5 font-bold shadow-sm" id="langBtn">
                    <i class="fa-solid fa-globe text-cyan-400"></i> <span>Türkçe</span>
                </button>
            </div>
        </div>
    </header>

    <!-- App Main Layout Container -->
    <main class="container mx-auto p-4 max-w-6xl my-2 flex-grow">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Panel: Form & Item Selection (7 Cols) -->
            <div class="lg:col-span-7 space-y-4">
                
                <!-- 1. Customer Information Card -->
                <div class="bg-white rounded-2xl shadow-sm p-4 border border-slate-200/80">
                    <h2 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2 pb-2 border-b border-slate-100">
                        <i class="fa-solid fa-user-tag text-blue-600 bg-blue-50 p-2 rounded-lg"></i> 
                        <span data-key="customer_info">بيانات الزبون</span>
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-1" data-key="lbl_name">اسم الزبون *</label>
                            <div class="relative">
                                <i class="fa-solid fa-user absolute right-3 top-3 text-slate-400 text-xs rtl:right-3 ltr:left-3"></i>
                                <input type="text" id="customerName" placeholder="مثال: أحمد الحمصي" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2 px-9 text-xs focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-1" data-key="lbl_phone">رقم الهاتف (WhatsApp)</label>
                            <div class="relative">
                                <i class="fa-solid fa-phone absolute right-3 top-3 text-slate-400 text-xs rtl:right-3 ltr:left-3"></i>
                                <input type="tel" id="customerPhone" placeholder="905xxxxxxxxx" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2 px-9 text-xs focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition" dir="ltr">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Item Selection & Service Customization Grid -->
                <div class="bg-white rounded-2xl shadow-sm p-4 border border-slate-200/80">
                    <h2 class="text-sm font-bold text-slate-800 mb-3 flex items-center justify-between pb-2 border-b border-slate-100">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-shirt text-blue-600 bg-blue-50 p-2 rounded-lg"></i> 
                            <span data-key="add_items">إضافة القطع والخدمات</span>
                        </span>
                        <span class="text-[11px] text-slate-400 font-normal" data-key="select_item_hint">اختر نوع الملابس أولاً</span>
                    </h2>
                    
                    <!-- Category Grid Buttons -->
                    <div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5 mb-4" id="itemGrid">
                        <!-- Dynamic items rendered by JS -->
                    </div>

                    <!-- Active Item Service Controls Box -->
                    <div id="serviceControls" class="bg-gradient-to-br from-slate-50 to-blue-50/30 p-4 rounded-xl border border-blue-100 space-y-4 hidden transition-all duration-300">
                        <div class="flex justify-between items-center border-b border-slate-200/60 pb-2">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-blue-600 animate-ping"></span>
                                <span id="selectedItemTitle" class="font-extrabold text-blue-900 text-sm"></span>
                            </div>
                            <span class="text-[11px] bg-blue-100 text-blue-800 px-2 py-0.5 rounded-md font-semibold" data-key="customize">تحديد الخدمات والعدد</span>
                        </div>

                        <!-- Services Checkboxes -->
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 mb-2" data-key="select_services">الخدمات المطلوبة:</label>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-semibold">
                                <label class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-slate-200 cursor-pointer hover:border-blue-400 transition shadow-sm">
                                    <input type="checkbox" id="srvWashing" onchange="calculateSuggestedPrice()" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4"> 
                                    <span data-key="srv_wash">غسيل</span>
                                </label>
                                <label class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-slate-200 cursor-pointer hover:border-blue-400 transition shadow-sm">
                                    <input type="checkbox" id="srvIroning" onchange="calculateSuggestedPrice()" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4"> 
                                    <span data-key="srv_iron">كوي</span>
                                </label>
                                <label class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-slate-200 cursor-pointer hover:border-blue-400 transition shadow-sm">
                                    <input type="checkbox" id="srvDryClean" onchange="calculateSuggestedPrice()" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4"> 
                                    <span data-key="srv_dryclean">غسيل جاف</span>
                                </label>
                                <label class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-slate-200 cursor-pointer hover:border-blue-400 transition shadow-sm">
                                    <input type="checkbox" id="srvTailoring" onchange="calculateSuggestedPrice()" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4"> 
                                    <span data-key="srv_tailor">خياطة</span>
                                </label>
                            </div>
                        </div>

                        <!-- Quantity and Custom Price Inputs -->
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-slate-500 mb-1" data-key="quantity">العدد (الكمية)</label>
                                <div class="flex items-center border border-slate-200 rounded-lg bg-white overflow-hidden shadow-sm">
                                    <button onclick="changeQty(-1)" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 transition font-bold text-sm">-</button>
                                    <input type="number" id="itemQty" value="1" min="1" onchange="calculateSuggestedPrice()" class="w-full py-1 text-center font-bold text-slate-800 text-sm outline-none">
                                    <button onclick="changeQty(1)" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 transition font-bold text-sm">+</button>
                                </div>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-slate-500 mb-1" data-key="price">السعر الإجمالي (TL)</label>
                                <div class="relative">
                                    <input type="number" id="itemPrice" placeholder="0.00" step="0.5" class="w-full border border-slate-200 rounded-lg p-2 text-sm text-center font-extrabold text-blue-900 bg-white shadow-sm focus:ring-2 focus:ring-blue-500 outline-none">
                                    <span class="absolute left-2 top-2.5 text-xs font-bold text-slate-400 rtl:left-2 ltr:right-2">TL</span>
                                </div>
                            </div>
                        </div>

                        <!-- Notes/Details -->
                        <div>
                            <input type="text" id="itemNotes" placeholder="ملاحظات خاصة بالقطعة (مثال: بقعة على الكم، لون أبيض...)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs focus:ring-1 focus:ring-blue-500 outline-none">
                        </div>

                        <button onclick="addItemToCart()" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2.5 rounded-xl text-xs font-extrabold transition shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cart-plus text-sm"></i> 
                            <span data-key="btn_add">إضافة القطعة للسلة</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Cart Summary & Actions (5 Cols) -->
            <div class="lg:col-span-5 space-y-4">
                <div class="bg-white rounded-2xl shadow-sm p-4 border border-slate-200/80 sticky top-20 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
                            <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-receipt text-blue-600 bg-blue-50 p-2 rounded-lg"></i> 
                                <span data-key="cart">سلة الطلب الراهن</span>
                            </h2>
                            <span id="cartCount" class="bg-blue-600 text-white text-xs font-extrabold px-2.5 py-0.5 rounded-full shadow-sm">0</span>
                        </div>

                        <!-- Cart Items Scroll Area -->
                        <div id="cartList" class="space-y-2 max-h-[320px] overflow-y-auto pr-1 mb-4 divide-y divide-slate-100">
                            <!-- Dynamic Cart Items -->
                            <div class="text-center text-slate-400 py-10 flex flex-col items-center gap-2">
                                <i class="fa-solid fa-basket-shopping text-4xl text-slate-200"></i>
                                <p class="text-xs" data-key="cart_empty">السلة فارغة حالياً، أضف قطعاً للبدء</p>
                            </div>
                        </div>
                    </div>

                    <!-- Checkout Box -->
                    <div class="border-t border-slate-200 pt-3 space-y-3 bg-slate-50/50 p-3 rounded-xl">
                        <div class="flex justify-between items-center font-extrabold text-slate-800">
                            <span class="text-xs" data-key="total">المجموع الكلي:</span>
                            <span id="totalPrice" class="text-xl text-blue-900 tracking-tight">0.00 TL</span>
                        </div>

                        <div class="grid grid-cols-1 gap-2">
                            <button onclick="confirmAndSend()" class="w-full bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white py-3 rounded-xl text-xs font-extrabold transition shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                                <i class="fa-solid fa-print text-sm"></i> 
                                <span data-key="btn_confirm">تأكيد وحفظ وطباعة الفاتورة</span>
                            </button>
                            
                            <button onclick="sendViaWhatsApp()" class="w-full bg-slate-800 hover:bg-slate-900 text-emerald-400 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-2 border border-slate-700">
                                <i class="fa-brands fa-whatsapp text-lg text-emerald-400"></i> 
                                <span data-key="btn_whatsapp">إرسال الفاتورة عبر واتساب</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- History Modal -->
    <div id="historyModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-3xl w-full max-h-[85vh] flex flex-col overflow-hidden border border-slate-100">
            <div class="p-4 bg-blue-900 text-white flex justify-between items-center">
                <h3 class="font-bold text-sm flex items-center gap-2">
                    <i class="fa-solid fa-boxes-packing text-cyan-300"></i>
                    <span data-key="history_title">سجل الفواتير والطلبات السابقة</span>
                </h3>
                <button onclick="closeHistoryModal()" class="text-slate-300 hover:text-white transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <div class="p-4 overflow-y-auto flex-grow" id="historyOrdersList">
                <!-- Dynamic History Cards -->
            </div>

            <div class="p-3 bg-slate-50 border-t border-slate-200 flex justify-between items-center text-xs">
                <button onclick="clearAllHistory()" class="text-red-500 hover:text-red-700 font-bold flex items-center gap-1">
                    <i class="fa-solid fa-trash"></i> <span data-key="clear_history">مسح كافة السجلات</span>
                </button>
                <button onclick="closeHistoryModal()" class="bg-slate-200 hover:bg-slate-300 px-4 py-1.5 rounded-lg font-bold text-slate-700">
                    <span data-key="close">إغلاق</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Hidden Printable Receipt Template -->
    <div id="printable-receipt" class="hidden bg-white text-slate-900 text-xs leading-tight">
        <div class="text-center border-b border-dashed border-slate-400 pb-3 mb-3">
            <h2 class="text-lg font-black tracking-widest uppercase">ALHOMSI LAUNDRY</h2>
            <p class="text-[10px] text-slate-600 font-bold">مغسلة ملابس الحمصي الحديثة</p>
            <p class="font-bold my-1 text-[10px] text-slate-700" id="rcptHeader">تشرفنا بمراجعتكم ونشكركم لثقتكم بنا</p>
            <p id="rcptDate" class="text-[9px] text-slate-500 mt-1"></p>
            <p id="rcptOrderNo" class="text-[10px] font-bold text-slate-800"></p>
        </div>

        <div class="mb-3 text-[11px] space-y-0.5 border-b border-dashed border-slate-400 pb-2">
            <p><strong>اسم الزبون:</strong> <span id="rcptCustomer"></span></p>
            <p><strong>الهاتف:</strong> <span id="rcptPhone"></span></p>
        </div>

        <table class="w-full text-right text-[10px] mb-3">
            <thead>
                <tr class="border-b border-slate-400 text-slate-600">
                    <th class="py-1 text-right">القطعة</th>
                    <th class="py-1 text-right">الخدمة</th>
                    <th class="py-1 text-center">العدد</th>
                    <th class="py-1 text-left">السعر</th>
                </tr>
            </thead>
            <tbody id="rcptItems" class="divide-y divide-slate-200"></tbody>
        </table>

        <div class="border-t border-b border-slate-800 py-1.5 text-left font-black text-xs mb-3 flex justify-between items-center">
            <span>المجموع الإجمالي:</span>
            <span><span id="rcptTotal"></span> TL</span>
        </div>

        <div class="text-center text-[9px] text-slate-600 space-y-1">
            <p class="font-bold">شكراً لزيارتكم - İstanbul Sarıyer</p>
            <p dir="ltr">+90 552 516 77 81</p>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 text-[11px] py-3 text-center border-t border-slate-800">
        <p>© 2026 ALHOMSI Laundry Management System. All Rights Reserved.</p>
    </footer>

    <!-- Main JavaScript Logic -->
    <script>
        // Item catalog with icons and base service prices (in TL)
        const clothes = [
            { id: 'custom', name_ar: '✨ قطعة مخصصة', name_tr: '✨ Özel Ürün', icon: 'fa-pen-to-square', basePrice: 50 },
            { id: 'jacket', name_ar: 'جاكيت / ستره', name_tr: 'Ceket', icon: 'fa-user-tie', basePrice: 100 },
            { id: 'pants', name_ar: 'بنطال', name_tr: 'Pantolon', icon: 'fa-socks', basePrice: 60 },
            { id: 'shirt', name_ar: 'قميص', name_tr: 'Gömlek', icon: 'fa-shirt', basePrice: 50 },
            { id: 'tshirt', name_ar: 'تيشيرت', name_tr: 'T-Shirt', icon: 'fa-vest', basePrice: 40 },
            { id: 'coat', name_ar: 'معطف / بالطو', name_tr: 'Palto / Mont', icon: 'fa-coat', basePrice: 150 },
