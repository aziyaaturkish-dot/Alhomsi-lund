                cart_empty: 'Sepet henüz boş',
                total: 'Genel Toplam:',
                btn_confirm: 'Siparişi Kaydet ve Gönder',
                btn_history: 'Sipariş Geçmişi',
                history_title: 'Geçmiş Siparişler ve Faturalar'
            }
        };

        function showToast(msg, type = 'info') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            
            let icon = '<i class="fa-solid fa-circle-info text-blue-400"></i>';
            if (type === 'success') icon = '<i class="fa-solid fa-circle-check text-emerald-400"></i>';
            if (type === 'warning') icon = '<i class="fa-solid fa-triangle-exclamation text-amber-400"></i>';

            toastMsg.innerHTML = `${icon} <span>${msg}</span>`;
            toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-10');
            
            setTimeout(() => {
                hideToast();
            }, 4000);
        }

        function hideToast() {
            const toast = document.getElementById('toast');
            toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-10');
        }

        function renderItems() {
            const grid = document.getElementById('itemGrid');
            grid.innerHTML = clothes.map(c => `
                <button onclick="selectCloth('${c.id}')" id="btn_item_${c.id}" class="flex flex-col items-center justify-center p-3 border rounded-xl hover:bg-blue-50 hover:border-blue-400 transition text-slate-700 bg-white shadow-sm border-slate-200 focus:outline-none">
                    <i class="fa-solid ${c.icon} text-lg text-blue-600 mb-1"></i>
                    <span class="text-xs font-bold">${currentLang === 'ar' ? c.name_ar : c.name_tr}</span>
                </button>
            `).join('');
        }

        function selectCloth(id) {
            selectedItem = clothes.find(c => c.id === id);
            
            // Highlight active button
            clothes.forEach(c => {
                const btn = document.getElementById(`btn_item_${c.id}`);
                if (btn) btn.classList.remove('bg-blue-100', 'border-blue-500', 'ring-2', 'ring-blue-400');
            });
            const activeBtn = document.getElementById(`btn_item_${id}`);
            if (activeBtn) activeBtn.classList.add('bg-blue-100', 'border-blue-500', 'ring-2', 'ring-blue-400');

            const title = currentLang === 'ar' ? selectedItem.name_ar : selectedItem.name_tr;
            document.getElementById('selectedItemTitle').innerHTML = `<i class="fa-solid ${selectedItem.icon} text-blue-600"></i> ${title}`;
            
            const customContainer = document.getElementById('customNameContainer');
            if (id === 'custom') {
                customContainer.classList.remove('hidden');
                document.getElementById('customItemInput').focus();
            } else {
                customContainer.classList.add('hidden');
            }

            document.getElementById('itemPrice').value = selectedItem.basePrice || '';
            document.getElementById('itemQty').value = 1;
            document.getElementById('srvWashing').checked = true;
            document.getElementById('srvIroning').checked = false;
            document.getElementById('srvDryClean').checked = false;
            document.getElementById('srvTailoring').checked = false;

            document.getElementById('serviceControls').classList.remove('hidden');
        }

        function changeQty(delta) {
            const qtyInput = document.getElementById('itemQty');
            let val = parseInt(qtyInput.value) || 1;
            val = Math.max(1, val + delta);
            qtyInput.value = val;
        }

        function addItemToCart() {
            if (!selectedItem) return;

            let itemName = currentLang === 'ar' ? selectedItem.name_ar : selectedItem.name_tr;
            if (selectedItem.id === 'custom') {
                const customVal = document.getElementById('customItemInput').value.trim();
                if (!customVal) {
                    showToast(currentLang === 'ar' ? 'لطفاً أدخل اسم القطعة المخصصة' : 'Lütfen özel ürün adını girin', 'warning');
                    return;
                }
                itemName = customVal;
            }

            const qty = parseInt(document.getElementById('itemQty').value) || 1;
            const price = parseFloat(document.getElementById('itemPrice').value) || 0;

            const services = [];
            if (document.getElementById('srvWashing').checked) services.push(currentLang === 'ar' ? 'غسيل' : 'Yıkama');
            if (document.getElementById('srvIroning').checked) services.push(currentLang === 'ar' ? 'كوي' : 'Ütü');
            if (document.getElementById('srvDryClean').checked) services.push(currentLang === 'ar' ? 'غسيل جاف' : 'Kuru');
            if (document.getElementById('srvTailoring').checked) services.push(currentLang === 'ar' ? 'خياطة' : 'Terzi');

            cart.push({
                id: Date.now(),
                name: itemName,
                qty: qty,
                price: price,
                services: services.join(' + ') || '-'
            });

            updateCart();
            showToast(currentLang === 'ar' ? 'تمت إضافة القطعة للسلة بنجاح' : 'Ürün sepete eklendi', 'success');

            // Reset controls
            document.getElementById('serviceControls').classList.add('hidden');
            document.getElementById('customItemInput').value = '';
            selectedItem = null;
        }

        function updateCart() {
            const list = document.getElementById('cartList');
            const totalEl = document.getElementById('totalPrice');
            document.getElementById('cartCount').innerText = cart.length;

            if (cart.length === 0) {
                list.innerHTML = `<p class="text-center text-slate-400 py-6">${translations[currentLang].cart_empty}</p>`;
                totalEl.innerText = '0.00 TL';
                return;
            }

            let total = 0;
            list.innerHTML = cart.map((item, idx) => {
                total += item.price;
                return `
                    <div class="flex justify-between items-center py-2">
                        <div>
                            <p class="font-bold text-slate-800">${item.name} <span class="text-blue-600 font-extrabold">(x${item.qty})</span></p>
                            <p class="text-[10px] text-slate-500">${item.services}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-slate-800">${item.price.toFixed(2)} TL</span>
                            <button onclick="cart.splice(${idx},1); updateCart();" class="text-red-400 hover:text-red-600 p-1"><i class="fa-solid fa-trash text-xs"></i></button>
                        </div>
                    </div>
                `;
            }).join('');

            totalEl.innerText = total.toFixed(2) + ' TL';
        }

        // Confirm & Save Order (Integrated with Evolution API & Firestore & Printing)
        async function confirmAndSend() {
            await confirmAndSaveOrder();
        }

        async function confirmAndSaveOrder() {
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();

            if (!name || !phone || cart.length === 0) {
                showToast('لطفاً أدخل اسم الزبون، ورقم الهاتف، وأضف قطعة واحدة على الأقل!', 'warning');
                return;
            }

            const total = cart.reduce((sum, i) => sum + i.price, 0);
            const orderNo = '#' + Math.floor(100000 + Math.random() * 900000);
            const dateStr = new Date().toLocaleString(currentLang === 'ar' ? 'ar-EG' : 'tr-TR');

            const newOrder = {
                id: orderNo,
                date: dateStr,
                customer: name,
                phone: phone || '-',
                items: [...cart],
                total: total
            };

            // 1. Save to Firebase Firestore
            try {
                if (window.db && window.addDoc && window.collection) {
                    await window.addDoc(window.collection(window.db, "orders"), {
                        orderNo: orderNo,
                        customerName: name,
                        customerPhone: phone,
                        items: cart,
                        totalAmount: total,
                        createdAt: window.serverTimestamp ? window.serverTimestamp() : new Date()
                    });
                }
            } catch (e) {
                console.error("Error saving to Firestore: ", e);
            }

            // Save to local history
            orderHistory.unshift(newOrder);
            localStorage.setItem('alhomsi_laundry_orders', JSON.stringify(orderHistory));

            // 2. Send via Evolution API
            let itemsText = cart.map(i => `• ${i.name} (${i.services}) x${i.qty} - ${i.price.toFixed(2)} TL`).join('\n');
            
            let whatsappMessage = `*ALHOMSI LAUNDRY* 🧺\n` +
                `زبائن ALHOMSI الكرام تشرفنا بكم ونشكركم على اختياركم لنا\n\n` +
                `👤 *Sayın Müşteri / الزبون:* ${name}\n` +
                `📋 *Sipariş Detayları / تفاصيل الطلب:*\n${itemsText}\n\n` +
                `💰 *Toplam / المجموع:* ${total.toFixed(2)} TL\n\n` +
                `📍 *مغسلة ملابس ALHOMSI*\nİstanbul Sarıyer | +905525167781`;

            const serverUrl = localStorage.getItem('evo_server_url') || '';
            const instanceName = localStorage.getItem('evo_instance_name') || 'alhomsi_laundry';
            const apiKey = localStorage.getItem('evo_api_key') || '';

            if (serverUrl && apiKey) {
                try {
                    let formattedPhone = phone.replace(/[^0-9]/g, '');

                    await fetch(`${serverUrl}/message/sendText/${instanceName}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'apikey': apiKey
                        },
                        body: JSON.stringify({
                            number: formattedPhone,
                            text: whatsappMessage
                        })
                    });
                    
                    showToast('تم حفظ الطلب وإرسال الفيش عبر الواتساب بنجاح!', 'success');
                } catch (err) {
                    console.error("WhatsApp Send Error:", err);
                    showToast('تم حفظ الطلب بالنظام، ولكن تعذر إرسال الواتساب التلقائي.', 'warning');
                }
            } else {
                showToast('تم حفظ الطلب! (لم يتم إرسال الواتساب التلقائي: يرجى ضبط Evolution API من الأيقونة بالأعلى)', 'warning');
            }

            // 3. Print thermal receipt
            printReceiptWindow(name, phone, total, orderNo, dateStr);

            // Clear inputs
            cart = [];
            updateCart();
            document.getElementById('customerName').value = '';
            document.getElementById('customerPhone').value = '';
        }

        function printReceiptWindow(name, phone, total, orderNo, dateStr) {
            document.getElementById('rcptCustomer').innerText = name;
            document.getElementById('rcptPhone').innerText = phone || '-';
            document.getElementById('rcptDate').innerText = dateStr || new Date().toLocaleString();
            if (orderNo) document.getElementById('rcptOrderNo').innerText = 'رقم الطلب: ' + orderNo;
            
            document.getElementById('rcptItems').innerHTML = cart.map(i => {
                return `<tr><td class="py-1 font-bold">${i.name}</td><td class="py-1 text-slate-600">${i.services}</td><td class="py-1 text-center font-bold">${i.qty}</td><td class="py-1 text-left font-bold">${i.price.toFixed(2)} TL</td></tr>`;
            }).join('');
            document.getElementById('rcptTotal').innerText = total.toFixed(2);

            window.print();
        }

        // Evolution API Settings Modal Handlers
        function openApiConfigModal() {
            document.getElementById('evoServerUrl').value = localStorage.getItem('evo_server_url') || '';
            document.getElementById('evoInstanceName').value = localStorage.getItem('evo_instance_name') || 'alhomsi_laundry';
            document.getElementById('evoApiKey').value = localStorage.getItem('evo_api_key') || '';
            document.getElementById('apiConfigModal').classList.remove('hidden');
        }

        function closeApiConfigModal() {
            document.getElementById('apiConfigModal').classList.add('hidden');
        }

        function saveApiConfig() {
            const url = document.getElementById('evoServerUrl').value.trim();
            const instance = document.getElementById('evoInstanceName').value.trim();
            const key = document.getElementById('evoApiKey').value.trim();

            localStorage.setItem('evo_server_url', url);
            localStorage.setItem('evo_instance_name', instance);
            localStorage.setItem('evo_api_key', key);

            closeApiConfigModal();
            showToast('تم حفظ إعدادات Evolution API بنجاح', 'success');
        }

        // History Modal Handlers
        function openHistoryModal() {
            renderHistory();
            document.getElementById('historyModal').classList.remove('hidden');
        }

        function closeHistoryModal() {
            document.getElementById('historyModal').classList.add('hidden');
        }

        function renderHistory() {
            const container = document.getElementById('historyContainer');
            if (orderHistory.length === 0) {
                container.innerHTML = '<p class="text-center text-slate-400 py-8 text-xs">لا يوجد طلبات سابقة في السجل المحلي</p>';
                return;
            }

            container.innerHTML = orderHistory.map(ord => {
                const itemsText = ord.items.map(i => `${i.name} (${i.services}) x${i.qty}`).join(', ');
                return `
                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs space-y-2 hover:border-blue-300 transition">
                        <div class="flex justify-between items-center font-bold border-b pb-1.5 text-blue-900">
                            <span>${ord.customer} <span class="text-slate-400 font-normal">(${ord.phone})</span></span>
                            <span class="bg-blue-100 text-blue-800 text-[10px] px-2 py-0.5 rounded font-mono">${ord.id}</span>
                        </div>
                        <p class="text-slate-600 text-[11px]">${itemsText}</p>
                        <div class="flex justify-between items-center pt-1 text-[11px]">
                            <span class="text-slate-400">${ord.date}</span>
                            <div class="flex items-center gap-3">
                                <span class="font-extrabold text-slate-800 text-sm">${ord.total.toFixed(2)} TL</span>
                                <button onclick="reprintOrder('${ord.id}')" class="bg-slate-200 hover:bg-slate-300 px-2 py-1 rounded text-slate-700 font-bold" title="طباعة الإيصال"><i class="fa-solid fa-print"></i></button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function reprintOrder(orderId) {
            const ord = orderHistory.find(o => o.id === orderId);
            if (!ord) return;

            document.getElementById('rcptCustomer').innerText = ord.customer;
            document.getElementById('rcptPhone').innerText = ord.phone;
            document.getElementById('rcptDate').innerText = ord.date;
            document.getElementById('rcptOrderNo').innerText = 'رقم الطلب: ' + ord.id;

            document.getElementById('rcptItems').innerHTML = ord.items.map(i => {
                return `<tr><td class="py-1 font-bold">${i.name}</td><td class="py-1 text-slate-600">${i.services}</td><td class="py-1 text-center font-bold">${i.qty}</td><td class="py-1 text-left font-bold">${i.price.toFixed(2)} TL</td></tr>`;
            }).join('');
            document.getElementById('rcptTotal').innerText = ord.total.toFixed(2);

            window.print();
        }

        function clearHistory() {
            orderHistory = [];
            localStorage.removeItem('alhomsi_laundry_orders');
            renderHistory();
            showToast('تم مسح السجل المحلي للطلبات', 'info');
        }

        function toggleLanguage() {
            currentLang = currentLang === 'ar' ? 'tr' : 'ar';
            document.documentElement.dir = currentLang === 'ar' ? 'rtl' : 'ltr';
            document.getElementById('langBtn').innerHTML = currentLang === 'ar' ? '<i class="fa-solid fa-globe mr-1"></i> Türkçe' : '<i class="fa-solid fa-globe mr-1"></i> العربية';
            
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (translations[currentLang][key]) {
                    el.innerText = translations[currentLang][key];
                }
            });

            renderItems();
            updateCart();
        }

        // Initialize
        renderItems();
    </script>
</body>
</html>
